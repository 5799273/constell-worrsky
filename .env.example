# Vercel Project Settings > Environment Variables에 같은 값을 등록하세요.
OPENAI_API_KEY=

# 선택 사항: 분석에 사용할 OpenAI 모델. 비워 두면 서버는 gpt-5.6-luna를 사용합니다.
OPENAI_MODEL=gpt-5.6-luna

# Server-only envelope encryption settings. Never prefix these with VITE_.
APP_ENCRYPTION_KEK_V1=
APP_ENCRYPTION_KEY_VERSION=1

# Vite 클라이언트용 공개 Supabase 설정 (service_role key는 절대 넣지 마세요.)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
